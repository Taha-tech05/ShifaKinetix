# Copy this file to .env and fill in the values. Never commit .env.

# Groq API key from https://console.groq.com/keys
# Leave empty to run without a model: the agent then plans in code and write-ups use templates.
GROQ_API_KEY=

# Optional: which Groq model to use. Check the current list at https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b

# Database. Leave empty for a local SQLite file (server/shifakinetix.db).
# PostgreSQL example: postgresql+psycopg://shifa:change-me@localhost:5432/shifakinetix
DATABASE_URL=

# Development only: set to 1 to enable POST /auth/dev-login, which issues tokens without a password.
# Never enable on a server that holds real data.
SHIFA_DEV_LOGIN=
